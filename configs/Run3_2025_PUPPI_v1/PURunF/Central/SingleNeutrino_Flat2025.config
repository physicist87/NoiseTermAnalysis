# NoiseTermAnalysis config - MC, Run3 2025 PUPPI (SingleNeutrino gun, flat
# PU0to120) - PU-reweighting CLOSURE-CHECK variant, target = RunF only.
#
# Same MC sample as MC/Central/SingleNeutrino_Flat2025.config, but
# reweighted to RunF's own official PU profile instead of the full-Run
# merged one, so MC and Data_ZeroBias_Run2025F.config can be compared
# directly to check the PU reweighting closes per era. Not used for the
# main analysis result - see MC/Central for that.
#
# NOTE: this is a TARGET config written for the correctionlib-based
# NoiseTermCorrections class that is not written yet. The current
# NoiseTerm.hpp constructor still reads the OLD txt-file/JetVeto keys
# (JECApply, JECUserCust, JECType, JECEra, L1JetParsTxtName,
# L2JetParsTxtName, L3JetParsTxtName, ResJetParsTxtName,
# JecUncertTxtName, DoJetVeto, JetVetoFName, JetVetoHName) - those are
# dropped below and replaced with the JEC*/JetVeto* keys under
# "Corrections (correctionlib)". This file will only fully work once
# NoiseTerm.hpp is updated to construct NoiseTermCorrections from these
# new keys instead.
#
# Directory layout (2026-09-17, matches the Cone08_2018_v1 precedent):
# configs/Run3_2025_PUPPI_v1/Central/<Sample>.config for the main Data
# (ZeroBias) samples. MC lives one level deeper: configs/Run3_2025_PUPPI_v1/
# <Category>/Central/<Sample>.config, where MC/Central = nominal and
# PURunC..G/Central (this file) = per-era closure-check variants. Matches
# Cone08_2018_v1/PURunA..D/Central/SingleNeutrino_Flat2018.config exactly.

######### Pile Up files (unchanged mechanism - edm::LumiReWeighting) #########
# PileUpMCFileName (denominator) = our own mu-branch histogram from the
# SingleNeutrino_Flat2025 MC sample itself (same for every PURun* variant).
# PileUpDATAFileName (numerator/target) = official pileupCalc profile for
# RunF specifically - this is what makes this a "closure check for RunF".
PileUpMCFileName : "For2025/PileupMC.root"
PileUpDATAFileName : "For2025/v1_RunF.root"
DoPUCor : "true"

######### Trigger requirement #########
# SingleNeutrino gun MC has no meaningful HLT decision - leave empty so
# NoiseTerm::Trigger()'s substring match against trigName never finds a
# match to skip on. Adjust if your ntuple's trigger_name/_pass branches
# should still be checked for this sample.
trigger : {""}
DoPrescale : "false"

######### Random cone reconstruction #########
JetType : "AK4PFPuppi"
JetCone : 0.4

######### Eta bins (output directory naming - EtaBin_<lo>_<hi>) #########
# Matches the bin edges already hardcoded in NoiseTerm.cpp (vEtaBins) -
# keep these two in sync if you change the binning.
EtaBins : {"0", "0.261", "0.522", "0.783", "1.044", "1.305", "1.566", "1.740", "1.930", "2.043", "2.172", "2.322", "2.500", "2.650", "2.853", "2.964", "3.139", "3.489", "3.839", "5.191"}

######### Corrections (correctionlib) #########
# jsonDir is auto-detected by NoiseTermCorrections (cvmfs CAT path ->
# legacy jsonpog-integration path -> local LCG fallback), these paths are
# relative to that jsonDir.

## JEC - confirmed 2025-09-10 from the actual jet_jerc.json.gz (V3, MC)
JECPath : "JME/Run3-25Prompt-Summer24-NanoAODv15/latest/jet_jerc.json.gz"
JECName : "Summer24Prompt25_V3_MC_L1L2L3Res_AK4PFPuppi"
JetAlgoTag : "AK4PFPuppi"
JECLevel : "L1L2L3Res"

## JER - not applied to random-cone jets (Seungkyu, 2026-09-15): RC jets
## are pseudo-jets built from a random pf-candidate sum, not reconstructed
## jets, so JER smearing/SF has no physical target here. No JER* keys.
## (For reference only, confirmed present in the same jet_jerc.json.gz:
##  Summer24Prompt25_JRV2_MC_PtResolution_AK4PFPuppi,
##  Summer24Prompt25_JRV2_MC_ScaleFactor_AK4PFPuppi,
##  Summer24Prompt25_JRV2_MC_SFUncertainty_AK4PFPuppi)

## Jet veto map - Summer24Prompt25_V1 (Seungkyu final decision, 2026-09-09).
## Applied to RC eta/phi directly, no jetID/EM-fraction preselection
## (see plan doc for reasoning). Typically not applied to MC noise-term
## samples the same way as data, but the key is included here for
## symmetry with the Data config - set DoJetVeto-equivalent logic in
## NoiseTermCorrections/NoiseTerm as appropriate once wired in.
JetVetoPath : "JME/Run3-25Prompt-Summer24-NanoAODv15/latest/jetvetomaps.json.gz"
JetVetoName : "Summer24Prompt25_V1"
JetVetoKey : "jetvetomap"
JetVetoType : "jet"
